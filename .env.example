# Mango Trading — required env (copy to .env)
# Server talks to db via service hostname "db" inside compose; localhost when running outside docker.

# PostgreSQL
POSTGRES_DB=mango_trading
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Server (Spring Boot)
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/mango_trading
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
JWT_SECRET=5367566B59703373367639792F423F4528482B4D6251655468576D5A71347437
JWT_EXPIRATION_MS=86400000

# Web (Next.js) — browser talks to server via localhost:8080 (see decision: web talk to server)
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# pgAdmin (optional, profile tools)
PGADMIN_DEFAULT_EMAIL=admin@mango.local
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050
